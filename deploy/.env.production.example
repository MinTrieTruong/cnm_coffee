# Copy thành /opt/tdcoffee/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.

# ── Chung ──
DOMAIN=tdcoffee.example.com
# Tên tài khoản GitHub viết thường (image nằm ở ghcr.io/<GH_OWNER>/...)
GH_OWNER=mintrietruong
IMAGE_TAG=latest

# ── Database (đặt mật khẩu dài, ngẫu nhiên: openssl rand -hex 24) ──
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── Backend ──
NODE_ENV=production
PORT=4000
STORE_NAME=TD Coffee
JWT_SECRET=

# ── Thanh toán (để trống nếu chưa dùng) ──
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_IPN_URL=
