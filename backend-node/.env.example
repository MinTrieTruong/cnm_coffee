# Tham số ?... giúp ổn định pool / timeout (MySQL idle drop). Giữ user/pass/db khớp docker-compose.yml.
DATABASE_URL="mysql://coffee:coffee123@localhost:3307/coffee_shop_db?connect_timeout=30&pool_timeout=30&connection_limit=10"
PORT=4000
STORE_NAME=TD Coffee
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Web Push — tạo bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# Đăng nhập khách bằng Google / Facebook — hướng dẫn: docs/social-login-setup.md
# Thiếu biến nào thì nút tương ứng tự ẩn (không làm sập app).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AI tư vấn (Gemini + kho tri thức) — tạo khóa ở aistudio.google.com, khóa chỉ để ở backend.
# Thiếu khóa: kho tri thức vẫn cắt đoạn và tìm theo từ khóa; có khóa thì tạo thêm embedding (tìm theo nghĩa).
# Đổi model embedding / số chiều → bấm "Xử lý lại" các tài liệu để tạo lại vector.
GEMINI_API_KEY=
# gemini-2.5-* đã ngừng cấp cho tài khoản mới; model chính quá tải thì AI tự dùng model lite
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# PDF dạng ảnh (scan): true = nhờ Gemini đọc chữ; false = báo lỗi "PDF dạng ảnh"
AI_PDF_OCR=false
