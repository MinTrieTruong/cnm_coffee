generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Cấu hình chung cả chuỗi (1 dòng): VAT, quy đổi điểm. Toạ độ/bán kính nằm ở từng Store.
model StoreSettings {
  id                 Int   @id @default(1)
  vatRatePercent     Int   @default(10) @map("VAT_Rate_Percent")
  /// Legacy — không dùng cho công thức tích điểm mới
  pointPerVnd        Int   @default(10000) @map("Point_Per_VND")
  /// 1 điểm đổi được bao nhiêu VND giảm trừ (1 = 1 điểm = 1đ)
  pointValueVnd      Int   @default(1) @map("Point_Value_VND")
  cashRoundTo        Int   @default(1000) @map("Cash_Round_To")
  /// Cứ mỗi N VND thành tiền thanh toán → cộng `pointEarnEach` điểm
  pointEarnEveryVnd  Int   @default(1000) @map("Point_Earn_Every_VND")
  pointEarnEach      Int   @default(100) @map("Point_Earn_Each")
  /// Độ nhạy nhận diện khuôn mặt (FaceID) - càng thấp càng khắt khe
  faceMatchThreshold Float @default(0.5) @map("Face_Match_Threshold")
  /// Thu ngân tự chi từ két / ngăn kéo tối đa bao nhiêu mỗi phiếu; vượt mức cần quản lý duyệt
  pettyCashLimit     Int   @default(200000) @map("Petty_Cash_Limit")

  @@map("Store_Settings")
}

model Category {
  id        Int        @id @map("Category_ID")
  name      String     @map("Category_Name") @db.VarChar(255)
  sortOrder Int        @default(0) @map("Sort_Order")
  parentId  Int?       @map("Parent_ID")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  proposals MenuProposal[]
  @@map("Categories")
}

model InventoryItem {
  id            Int                       @id @map("Item_ID")
  name          String                    @map("Item_Name") @db.VarChar(255)
  category      String?                   @map("Category") @db.VarChar(100)
  skuCode       String?                   @unique @map("SKU_Code") @db.VarChar(50)
  unit          String?                   @map("Unit") @db.VarChar(20)
  supplier      String?                   @map("Supplier") @db.VarChar(100)
  /// Giá nhập mới nhất / đơn vị kho (để tính lợi nhuận)
  unitCostPrice Int                       @default(0) @map("Unit_Cost_Price")
  /// Đơn vị dùng trong công thức (g, ml, cái…)
  recipeUnit    String?                   @map("Recipe_Unit") @db.VarChar(20)
  /// 1 đơn vị kho = bao nhiêu đơn vị công thức (VD 1 bịch = 1000 g)
  recipePerUnit Float                     @default(1) @map("Recipe_Per_Unit")
  imageUrl      String?                   @map("Image_URL") @db.VarChar(1024)
  requests      InventoryRequest[]
  shiftLogs     ShiftInventoryLog[]
  formulas      ProductFormula[]
  receipts      StockReceipt[]
  transactions  InventoryTransaction[]
  prItems       PurchaseRequisitionItem[]
  quoteItems    SupplierQuoteItem[]
  batches       InventoryBatch[]
  grnItems      GoodsReceiptItem[]
  storeStocks   StoreInventory[]
  transferItems StockTransferItem[]

  wasteLogs     WasteLog[]
  stockRequests StockRequest[]
  @@map("Inventory")
}

model Product {
  id              Int              @id @map("Product_ID")
  categoryId      Int              @map("Category_ID")
  sku             String?          @unique @map("SKU") @db.VarChar(20)
  name            String           @map("Product_Name") @db.VarChar(255)
  costPrice       Int              @map("Cost_Price")
  sellPrice       Int              @map("Sell_Price")
  priceSizeS      Int?             @map("Price_Size_S")
  priceSizeL      Int?             @map("Price_Size_L")
  isActive        Boolean          @map("Is_Active")
  outOfStock      Boolean          @default(false) @map("Out_Of_Stock")
  isBestSeller    Boolean          @default(false) @map("Is_Best_Seller")
  discountPercent Int?             @map("Discount_Percent")
  imageUrl        String?          @map("Image_URL") @db.VarChar(1024)
  tags            Json?            @map("Tags")
  category        Category         @relation(fields: [categoryId], references: [id])
  orderLines      OrderDetail[]
  formulas        ProductFormula[]
  comboItems      ComboItem[]
  storeProducts   StoreProduct[]

  wasteLogs       WasteLog[]
  proposals       MenuProposal[]
  @@map("Products")
}

/// Định mức nguyên liệu: 1 sản phẩm → bao nhiêu nguyên liệu/ly
model ProductFormula {
  id               Int           @id @default(autoincrement()) @map("Formula_ID")
  productId        Int           @map("Product_ID")
  itemId           Int           @map("Item_ID")
  /// Số lượng tiêu thụ trên 1 ly size M (hoặc mặc định khi không phân size) — tính theo recipeUnit
  qtyPerUnit       Float         @map("Qty_Per_Unit")
  /// Định mức cho size S (null = dùng qtyPerUnit)
  qtySizeS         Float?        @map("Qty_Size_S")
  /// Định mức cho size M (null = dùng qtyPerUnit)
  qtySizeM         Float?        @map("Qty_Size_M")
  /// Định mức cho size L (null = dùng qtyPerUnit)
  qtySizeL         Float?        @map("Qty_Size_L")
  /// Đơn vị trong công thức, e.g. "g", "ml". Để trống = dùng đơn vị kho
  recipeUnit       String?       @map("Recipe_Unit") @db.VarChar(20)
  /// Bao nhiêu đơn vị công thức = 1 đơn vị kho. VD: 1 bịch(kho) = 1000g(công thức) → 1000
  conversionFactor Float         @default(1) @map("Conversion_Factor")
  note             String?       @map("Note") @db.VarChar(255)
  product          Product       @relation(fields: [productId], references: [id])
  item             InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([productId, itemId])
  @@map("Product_Formulas")
}

model Zone {
  id       Int         @id @default(autoincrement()) @map("Zone_ID")
  name     String      @map("Zone_Name") @db.VarChar(100)
  isActive Boolean     @default(true) @map("Is_Active")
  tables   CafeTable[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Zones")
}

model CafeTable {
  id                Int     @id @map("Table_ID")
  name              String  @map("Table_Name") @db.VarChar(64)
  location          String? @map("Location") @db.VarChar(100)
  capacity          Int     @default(4) @map("Capacity")
  qrCode            String? @map("QR_Code") @db.VarChar(512)
  status            String  @default("Empty") @map("Status") @db.VarChar(32)
  zoneId            Int?    @map("Zone_ID")
  mergedWithTableId Int?    @map("Merged_With_Table_ID")

  zone         Zone?       @relation(fields: [zoneId], references: [id])
  mergedWith   CafeTable?  @relation("MergedTables", fields: [mergedWithTableId], references: [id])
  mergedTables CafeTable[] @relation("MergedTables")
  orders       Order[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Tables")
}

/// Khách hàng — đăng nhập bằng SĐT hoặc Email + mật khẩu (theo cmn.md)
model Customer {
  id           Int               @id @map("Customer_ID")
  phone        String?           @unique @map("Phone") @db.VarChar(15)
  passwordHash String?           @map("Password_Hash") @db.VarChar(255)
  fullName     String            @map("Customer_Name") @db.VarChar(255)
  email        String?           @map("Email") @db.VarChar(100)
  address      String?           @map("Address") @db.VarChar(255)
  dob          DateTime?         @map("DOB")
  gender       String?           @map("Gender") @db.VarChar(10)
  avatarUrl    String?           @map("Avatar_URL") @db.VarChar(255)
  points       Int               @default(0) @map("Points")
  rankTier     String            @default("Dong") @map("Rank_Tier") @db.VarChar(20)
  createdAt    DateTime          @default(now()) @map("Created_At")
  lastLogin    DateTime?         @map("Last_Login")
  orders       Order[]
  reviews      Review[]
  userVouchers UserVoucher[]
  addresses    CustomerAddress[]

  @@map("Customers")
}

model CustomerAddress {
  id         Int      @id @default(autoincrement()) @map("Address_ID")
  customerId Int      @map("Customer_ID")
  address    String   @map("Address") @db.VarChar(500)
  lat        Float?   @map("Lat")
  lng        Float?   @map("Lng")
  isDefault  Boolean  @default(false) @map("Is_Default")
  createdAt  DateTime @default(now()) @map("Created_At")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("Customer_Addresses")
}

model Staff {
  id               Int                @id @map("Staff_ID")
  username         String?            @unique @map("Username") @db.VarChar(50)
  passwordHash     String?            @map("Password_Hash") @db.VarChar(255)
  fullName         String             @map("Staff_Name") @db.VarChar(100)
  phone            String?            @map("Phone") @db.VarChar(15)
  address          String?            @map("Address") @db.VarChar(255)
  dob              DateTime?          @map("DOB")
  cccd             String?            @unique @map("CCCD") @db.VarChar(20)
  role             String             @map("Role") @db.VarChar(20)
  baseSalary       Int                @default(0) @map("Base_Salary")
  allowance        Int                @default(0) @map("Allowance")
  hireDate         DateTime           @default(now()) @map("Hire_Date")
  status           String             @default("Active") @map("Status") @db.VarChar(20)
  /// Face descriptor JSON (128-d Float32Array) cho nhận diện khuôn mặt
  faceDescriptor   String?            @map("Face_Descriptor") @db.Text
  orders           Order[]
  shifts           Shift[]            @relation("ShiftStaff")
  workSchedules    WorkSchedule[]
  requestsMade     InventoryRequest[] @relation("RequestByStaff")
  requestsApproved InventoryRequest[] @relation("ApprovedByStaff")
  reviewsReply     Review[]
  receiptsGiven    StockReceipt[]
  auditLogs        AuditLog[]
  payslips         Payslip[]

  leaveRequests         LeaveRequest[]         @relation("LeaveRequests")
  leaveApprovals        LeaveRequest[]         @relation("LeaveApprovals")
  shiftSwapRequesters   ShiftSwapRequest[]     @relation("ShiftSwapRequesters")
  shiftSwapTargets      ShiftSwapRequest[]     @relation("ShiftSwapTargets")
  shiftSwapApprovals    ShiftSwapRequest[]     @relation("ShiftSwapApprovals")
  attendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustments")
  attendanceApprovals   AttendanceAdjustment[] @relation("AttendanceApprovals")
  workRequests          WorkRequest[]          @relation("WorkRequests")
  workRequestApprovals  WorkRequest[]          @relation("WorkRequestApprovals")
  purchaseRequisitions  PurchaseRequisition[]  @relation("PRByStaff")
  goodsReceipts         GoodsReceipt[]

  ordersShipped Order[] @relation("OrderShipper")

  transfersCreated  StockTransfer[] @relation("TransferCreatedBy")
  transfersReceived StockTransfer[] @relation("TransferReceivedBy")

  /// Shipper: đang bật nhận đơn hay không
  shipperOnline  Boolean   @default(false) @map("Shipper_Online")
  /// Shipper: vị trí GPS gần nhất
  lastLat        Float?    @map("Last_Lat")
  lastLng        Float?    @map("Last_Lng")
  lastLocationAt DateTime? @map("Last_Location_At")

  /// Chi nhánh
  storeId Int?   @map("Store_ID")
  store   Store? @relation(fields: [storeId], references: [id])

  wasteLogs             WasteLog[]
  stockRequests         StockRequest[]         @relation("StockRequestBy")
  stockRequestsAccepted StockRequest[]         @relation("StockRequestAcceptedBy")
  menuProposals         MenuProposal[]         @relation("MenuProposalBy")
  menuProposalsReviewed MenuProposal[]         @relation("MenuProposalReviewer")
  /// Thu chi & két
  cashEntriesCreated    CashEntry[]            @relation("CashEntryCreatedBy")
  cashEntriesApproved   CashEntry[]            @relation("CashEntryApprovedBy")
  safeSessionsOpened    SafeSession[]          @relation("SafeOpenedBy")
  safeSessionsClosed    SafeSession[]          @relation("SafeClosedBy")
  shiftsReviewed        Shift[]                @relation("ShiftReviewer")
  supplierBillsCreated  SupplierBill[]         @relation("SupplierBillCreatedBy")

  @@index([storeId])
  @@map("Staff")
}

model Shift {
  id            Int                 @id @default(autoincrement()) @map("Shift_ID")
  staffId       Int                 @map("Staff_ID")
  startTime     DateTime            @map("Start_Time")
  endTime       DateTime?           @map("End_Time")
  startingCash  Int                 @map("Starting_Cash")
  expectedCash  Int?                @map("Expected_Cash")
  actualCash    Int?                @map("Actual_Cash")
  differenceAmt Int?                @map("Difference")
  note          String?             @map("Note") @db.VarChar(255)
  /// Tiền mặt bán hàng trong ca (chốt lúc đóng ca)
  cashSales     Int?                @map("Cash_Sales")
  /// Số tờ theo mệnh giá khi đếm đóng ca, JSON {"500000": 2, ...}
  denominations String?             @map("Denominations") @db.Text
  /// Quản lý xác nhận báo cáo ca (đặc biệt khi có chênh lệch)
  reviewedById  Int?                @map("Reviewed_By")
  reviewedAt    DateTime?           @map("Reviewed_At")
  reviewNote    String?             @map("Review_Note") @db.VarChar(255)
  staff         Staff               @relation("ShiftStaff", fields: [staffId], references: [id])
  reviewedBy    Staff?              @relation("ShiftReviewer", fields: [reviewedById], references: [id])
  payments      Payment[]
  inventoryLogs ShiftInventoryLog[]
  cashEntries   CashEntry[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Shifts")
}

model Order {
  id              Int       @id @default(autoincrement()) @map("Order_ID")
  tableId         Int?      @map("Table_ID")
  customerId      Int?      @map("Customer_ID")
  staffId         Int?      @map("Staff_ID")
  sessionId       String?   @map("Session_ID") @db.VarChar(50)
  orderType       String    @map("Order_Type") @db.VarChar(32)
  subTotal        Int       @map("Sub_Total")
  discountAmt     Int       @default(0) @map("Discount_Amt")
  /// Điểm khách dùng để giảm giá (số điểm, không phải VND)
  pointsUsed      Int       @default(0) @map("Points_Used")
  /// Số tiền giảm từ điểm (VND) = pointsUsed × pointValueVnd
  pointsRedeemAmt Int       @default(0) @map("Points_Redeem_Amt")
  vatAmount       Int       @default(0) @map("VAT_Amount")
  totalAmount     Int       @map("Total_Amount")
  status          String    @default("Pending_Grace") @map("Status") @db.VarChar(32)
  cancelReason    String?   @map("Cancel_Reason") @db.VarChar(255)
  graceEndsAt     DateTime? @map("Grace_Ends_At")
  createdAt       DateTime  @default(now()) @map("Created_At")

  // Delivery fields
  deliveryAddress  String?   @map("Delivery_Address") @db.VarChar(500)
  customerLat      Float?    @map("Customer_Lat")
  customerLng      Float?    @map("Customer_Lng")
  shipperId        Int?      @map("Shipper_ID")
  shippingFee      Int       @default(0) @map("Shipping_Fee")
  deliveredAt      DateTime? @map("Delivered_At")
  /// Trạng thái giao hàng (tách khỏi trạng thái thanh toán `status`):
  /// Awaiting_Confirm → Preparing → Ready → Assigned → Delivering → Delivered | Failed | Rejected
  deliveryStatus   String?   @map("Delivery_Status") @db.VarChar(32)
  /// Thứ tự điểm dừng trong tuyến tối ưu của shipper (1 = giao trước)
  routeSeq         Int?      @map("Route_Seq")
  /// Ảnh xác nhận đã giao
  deliveryProofUrl String?   @map("Delivery_Proof_Url") @db.VarChar(1024)
  /// Ghi chú giao hàng / lý do thất bại
  deliveryNote     String?   @map("Delivery_Note") @db.VarChar(255)
  confirmedAt      DateTime? @map("Confirmed_At")
  readyAt          DateTime? @map("Ready_At")
  assignedAt       DateTime? @map("Assigned_At")
  pickedUpAt       DateTime? @map("Picked_Up_At")

  table    CafeTable? @relation(fields: [tableId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  staff    Staff?     @relation(fields: [staffId], references: [id])
  shipper  Staff?     @relation("OrderShipper", fields: [shipperId], references: [id])

  details  OrderDetail[]
  payments Payment[]
  reviews  Review[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Orders")
}

model OrderDetail {
  id          Int     @id @default(autoincrement()) @map("Detail_ID")
  orderId     Int     @map("Order_ID")
  productId   Int     @map("Product_ID")
  /// Nếu đây là 1 dòng thuộc combo, lưu comboId để biết (nullable)
  comboId     Int?    @map("Combo_ID")
  quantity    Int     @map("Quantity")
  unitPrice   Int     @map("Unit_Price")
  size        String? @map("Size") @db.VarChar(10)
  customNotes String? @map("Custom_Notes") @db.VarChar(512)
  kdsStatus   String  @default("Hold") @map("KDS_Status") @db.VarChar(32)
  priority    Boolean @default(false) @map("Priority_Flag")
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  combo       Combo?  @relation(fields: [comboId], references: [id])

  @@map("Order_Details")
}

model Payment {
  id          Int      @id @default(autoincrement()) @map("Payment_ID")
  orderId     Int      @map("Order_ID")
  shiftId     Int?     @map("Shift_ID")
  method      String   @map("Method") @db.VarChar(20)
  amount      Int      @map("Amount")
  transCode   String?  @map("Trans_Code") @db.VarChar(100)
  paymentTime DateTime @default(now()) @map("Payment_Time")
  order       Order    @relation(fields: [orderId], references: [id])
  shift       Shift?   @relation(fields: [shiftId], references: [id])

  @@map("Payments")
}

model Review {
  id         Int      @id @default(autoincrement()) @map("Review_ID")
  orderId    Int      @map("Order_ID")
  customerId Int      @map("Customer_ID")
  rating     Int      @map("Rating")
  comment    String?  @map("Comment") @db.VarChar(500)
  imageUrl   String?  @map("Image_URL") @db.VarChar(1024)
  adminReply String?  @map("Admin_Reply") @db.VarChar(500)
  replyById  Int?     @map("Reply_By")
  hidden     Boolean  @default(false) @map("Hidden")
  createdAt  DateTime @default(now()) @map("Created_At")
  order      Order    @relation(fields: [orderId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  replyBy    Staff?   @relation(fields: [replyById], references: [id])

  @@map("Reviews")
}

model InventoryRequest {
  id           Int           @id @default(autoincrement()) @map("Request_ID")
  staffId      Int           @map("Staff_ID")
  itemId       Int           @map("Item_ID")
  requestQty   Int           @map("Request_Qty")
  /// "Restock" = phiếu nhập hàng (từ nhân viên bán hàng), "Kitchen" = xin nguyên liệu (từ bếp)
  type         String        @default("Kitchen") @map("Type") @db.VarChar(20)
  status       String        @default("Pending") @map("Status") @db.VarChar(20)
  approvedById Int?          @map("Approved_By")
  note         String?       @map("Note") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("Created_At")
  approvedAt   DateTime?     @map("Approved_At")
  staff        Staff         @relation("RequestByStaff", fields: [staffId], references: [id])
  item         InventoryItem @relation(fields: [itemId], references: [id])
  approvedBy   Staff?        @relation("ApprovedByStaff", fields: [approvedById], references: [id])
  receipt      StockReceipt?

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Requests")
}

/// Lịch sử nhập kho — ghi lại mỗi lần hàng về kho
model StockReceipt {
  id           Int               @id @default(autoincrement()) @map("Receipt_ID")
  itemId       Int               @map("Item_ID")
  qty          Int               @map("Qty")
  /// "Request" = duyệt phiếu xin, "Manual" = nhập tay
  source       String            @default("Manual") @map("Source") @db.VarChar(20)
  requestId    Int?              @unique @map("Request_ID")
  supplierId   Int?              @map("Supplier_ID")
  unitPrice    Int?              @map("Unit_Price") // giá nhập lần này
  note         String?           @map("Note") @db.VarChar(255)
  expiryDate   DateTime?         @map("Expiry_Date")
  remainingQty Int               @default(0) @map("Remaining_Qty")
  receivedAt   DateTime          @default(now()) @map("Received_At")
  receivedById Int               @map("Received_By")
  item         InventoryItem     @relation(fields: [itemId], references: [id])
  request      InventoryRequest? @relation(fields: [requestId], references: [id])
  receivedBy   Staff             @relation(fields: [receivedById], references: [id])
  supplierRel  Supplier?         @relation(fields: [supplierId], references: [id])

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Stock_Receipts")
}

/// Nhà cung cấp nguyên liệu
model Supplier {
  id             Int             @id @default(autoincrement()) @map("Supplier_ID")
  username       String?         @unique @map("Username") @db.VarChar(50)
  passwordHash   String?         @map("Password_Hash") @db.VarChar(255)
  name           String          @map("Name") @db.VarChar(255)
  phone          String?         @map("Phone") @db.VarChar(20)
  address        String?         @map("Address") @db.VarChar(255)
  email          String?         @map("Email") @db.VarChar(100)
  note           String?         @map("Note") @db.VarChar(500)
  isActive       Boolean         @default(true) @map("Is_Active")
  /// Số ngày được nợ kể từ ngày nhận hàng (hạn thanh toán công nợ)
  paymentTermDays Int            @default(30) @map("Payment_Term_Days")
  createdAt      DateTime        @default(now()) @map("Created_At")
  receipts       StockReceipt[]
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]

  @@map("Suppliers")
}

/// Audit Log — ghi nhận mọi thao tác quan trọng
model AuditLog {
  id        Int      @id @default(autoincrement()) @map("Log_ID")
  staffId   Int?     @map("Staff_ID")
  /// VD: "INVENTORY_CHECK_OPEN", "ORDER_CREATE", "PAYMENT", "SHIFT_OPEN"
  action    String   @map("Action") @db.VarChar(100)
  /// VD: "Order #123", "Nguyên liệu: Cà Phê"
  target    String?  @map("Target") @db.VarChar(255)
  detail    String?  @map("Detail") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("Created_At")
  staff     Staff?   @relation(fields: [staffId], references: [id])

  /// Chi nhánh
  storeId Int?   @map("Store_ID")
  store   Store? @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Audit_Logs")
}

/// Nhật ký kiểm kho mở/kết ca của nhân viên
model ShiftInventoryLog {
  id        Int           @id @default(autoincrement()) @map("Log_ID")
  shiftId   Int?          @map("Shift_ID")
  itemId    Int           @map("Item_ID")
  /// "open" = kiểm kho mở ca, "close" = kiểm kho kết ca
  checkType String        @map("Check_Type") @db.VarChar(10)
  qty       Int           @map("Qty")
  note      String?       @map("Note") @db.VarChar(255)
  checkedAt DateTime      @default(now()) @map("Checked_At")
  shift     Shift?        @relation(fields: [shiftId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Shift_Inventory_Logs")
}

/// Voucher giam gia
model Voucher {
  id            Int            @id @default(autoincrement()) @map("Voucher_ID")
  code          String         @unique @map("Code") @db.VarChar(50)
  description   String?        @map("Description") @db.VarChar(500)
  discountValue Int            @map("Discount_Value")
  minBillValue  Int            @default(0) @map("Min_Bill_Value")
  startDate     DateTime       @default(now()) @map("Start_Date")
  endDate       DateTime       @map("End_Date")
  quantity      Int            @map("Quantity")
  usedCount     Int            @default(0) @map("Used_Count")
  isActive      Boolean        @default(true) @map("Is_Active")
  voucherType   String         @default("public") @map("Voucher_Type") @db.VarChar(20)
  goldHourStart Int?           @map("Gold_Hour_Start")
  goldHourEnd   Int?           @map("Gold_Hour_End")
  userVouchers  UserVoucher[]
  stores        VoucherStore[]
  createdAt     DateTime       @default(now()) @map("Created_At")

  @@map("Vouchers")
}

/// Voucher da duoc khach luu vao vi / da dung
model UserVoucher {
  id         Int       @id @default(autoincrement()) @map("UV_ID")
  customerId Int       @map("Customer_ID")
  voucherId  Int       @map("Voucher_ID")
  isUsed     Boolean   @default(false) @map("Is_Used")
  usedAt     DateTime? @map("Used_At")
  claimedAt  DateTime  @default(now()) @map("Claimed_At")
  orderId    Int?      @map("Order_ID")

  customer Customer @relation(fields: [customerId], references: [id])
  voucher  Voucher  @relation(fields: [voucherId], references: [id])

  @@unique([customerId, voucherId])
  @@map("User_Vouchers")
}

/// Bai dang khuyến mãi / thông báo từ Admin (hiển thị trên trang chủ quán)
model Post {
  id          Int      @id @default(autoincrement()) @map("Post_ID")
  title       String   @map("Title") @db.VarChar(255)
  body        String   @map("Body") @db.Text
  imageUrl    String?  @map("Image_URL") @db.VarChar(1024)
  pinned      Boolean  @default(false) @map("Pinned")
  isPublished Boolean  @default(true) @map("Is_Published")
  createdAt   DateTime @default(now()) @map("Created_At")
  updatedAt   DateTime @updatedAt @map("Updated_At")

  @@map("Posts")
}

/// ─── Đề xuất cá nhân (Nhân sự) ─────────────────────────────────

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TargetUserStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum LeaveType {
  FULL_DAY
  HALF_DAY
}

enum AdjustmentType {
  FORGET_CHECKIN
  FORGET_CHECKOUT
  LATE_IN
  EARLY_OUT
}

model LeaveRequest {
  id        Int           @id @default(autoincrement()) @map("LR_ID")
  userId    Int           @map("User_ID")
  /// Ngày bắt đầu nghỉ
  date      DateTime      @map("Date") @db.Date
  /// Ngày kết thúc (null = nghỉ 1 ngày)
  toDate    DateTime?     @map("To_Date") @db.Date
  leaveType LeaveType     @map("Leave_Type")
  reason    String        @map("Reason") @db.VarChar(500)
  status    RequestStatus @default(PENDING) @map("Status")
  managerId Int?          @map("Manager_ID")
  createdAt DateTime      @default(now()) @map("Created_At")
  updatedAt DateTime      @updatedAt @map("Updated_At")

  user    Staff  @relation("LeaveRequests", fields: [userId], references: [id])
  manager Staff? @relation("LeaveApprovals", fields: [managerId], references: [id])

  @@map("Leave_Requests")
}

model ShiftSwapRequest {
  id               Int              @id @default(autoincrement()) @map("SSR_ID")
  requesterId      Int              @map("Requester_ID")
  targetUserId     Int              @map("Target_User_ID")
  scheduleId       Int              @map("Schedule_ID")
  reason           String           @map("Reason") @db.VarChar(500)
  targetUserStatus TargetUserStatus @default(PENDING) @map("Target_User_Status")
  status           RequestStatus    @default(PENDING) @map("Status")
  managerId        Int?             @map("Manager_ID")
  createdAt        DateTime         @default(now()) @map("Created_At")
  updatedAt        DateTime         @updatedAt @map("Updated_At")

  requester  Staff        @relation("ShiftSwapRequesters", fields: [requesterId], references: [id])
  targetUser Staff        @relation("ShiftSwapTargets", fields: [targetUserId], references: [id])
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id])
  manager    Staff?       @relation("ShiftSwapApprovals", fields: [managerId], references: [id])

  @@map("Shift_Swap_Requests")
}

model AttendanceAdjustment {
  id             Int            @id @default(autoincrement()) @map("AA_ID")
  userId         Int            @map("User_ID")
  date           DateTime       @map("Date") @db.Date
  adjustmentType AdjustmentType @map("Adjustment_Type")
  proposedTime   DateTime       @map("Proposed_Time")
  reason         String         @map("Reason") @db.VarChar(500)
  status         RequestStatus  @default(PENDING) @map("Status")
  managerId      Int?           @map("Manager_ID")
  createdAt      DateTime       @default(now()) @map("Created_At")
  updatedAt      DateTime       @updatedAt @map("Updated_At")

  user    Staff  @relation("AttendanceAdjustments", fields: [userId], references: [id])
  manager Staff? @relation("AttendanceApprovals", fields: [managerId], references: [id])

  @@map("Attendance_Adjustments")
}

/// ─── Lịch làm việc (đăng ký ca) ─────────────────────────────────
enum WorkScheduleStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  OPEN_SHIFT
}

/// Nhân viên đăng ký ca mong muốn; Quản lý xét duyệt & chốt lịch.
model WorkSchedule {
  id              Int                @id @default(autoincrement()) @map("WS_ID")
  staffId         Int?               @map("Staff_ID")
  workDate        DateTime           @map("Work_Date") @db.Date
  /// Ca cố định: A | B | C | SP1 | SP2
  shiftCode       String             @default("A") @map("Shift_Code") @db.VarChar(10)
  /// Giờ bắt đầu (phút từ 00:00, VD 7*60=420)
  startMin        Int                @default(0) @map("Start_Min")
  /// Giờ kết thúc (phút từ 00:00, VD 12*60=720)
  endMin          Int                @default(0) @map("End_Min")
  status          WorkScheduleStatus @default(PENDING) @map("Status")
  staffNote       String?            @map("Staff_Note") @db.VarChar(500)
  managerNote     String?            @map("Manager_Note") @db.VarChar(500)
  reviewedBy      Int?               @map("Reviewed_By")
  /// Thời gian check-in thực tế
  actualCheckIn   DateTime?          @map("Actual_Check_In")
  /// Thời gian check-out thực tế
  actualCheckOut  DateTime?          @map("Actual_Check_Out")
  /// Cờ: nhân viên có xin tăng ca không
  isOvertime      Boolean            @default(false) @map("Is_Overtime")
  /// Số phút tăng ca được quản lý duyệt
  overtimeMinutes Int?               @map("Overtime_Minutes")
  /// Ghi chú xin tăng ca của nhân viên
  overtimeNote    String?            @map("Overtime_Note") @db.VarChar(500)
  /// Vị trí của ca (Cashier/Waiter/Kitchen…) — giữ lại khi ca thành ca trống
  role            String?            @map("Role") @db.VarChar(20)
  /// Đi muộn đã được duyệt đơn — không tính cảnh báo
  lateExcused     Boolean            @default(false) @map("Late_Excused")
  /// Về sớm đã được duyệt đơn — không tính cảnh báo
  earlyExcused    Boolean            @default(false) @map("Early_Excused")
  createdAt       DateTime           @default(now()) @map("Created_At")
  updatedAt       DateTime           @updatedAt @map("Updated_At")

  staff             Staff?             @relation(fields: [staffId], references: [id])
  shiftSwapRequests ShiftSwapRequest[]
  workRequests      WorkRequest[]
  /// Chi nhánh
  storeId           Int                @map("Store_ID")
  store             Store              @relation(fields: [storeId], references: [id])

  @@unique([staffId, workDate, shiftCode])
  @@index([staffId])
  @@index([workDate])
  @@index([storeId])
  @@map("Work_Schedules")
}

/// Phiên chat của khách — 1 phiên = 1 cuộc trò chuyện
model ChatSession {
  id         Int           @id @default(autoincrement()) @map("Session_ID")
  /// Khách đã đăng nhập (null nếu vãng lai)
  customerId Int?          @map("Customer_ID")
  /// Tên hiển thị (khách vãng lai thì để "Khách")
  guestName  String        @default("Khách") @map("Guest_Name") @db.VarChar(100)
  tableId    Int?          @map("Table_ID")
  /// "open" | "closed"
  status     String        @default("open") @map("Status") @db.VarChar(20)
  createdAt  DateTime      @default(now()) @map("Created_At")
  updatedAt  DateTime      @updatedAt @map("Updated_At")
  messages   ChatMessage[]
  /// Chi nhánh
  storeId    Int           @map("Store_ID")
  store      Store         @relation(fields: [storeId], references: [id])

  @@index([status])
  @@index([storeId])
  @@map("Chat_Sessions")
}

/// Từng tin nhắn trong phiên chat
model ChatMessage {
  id         Int         @id @default(autoincrement()) @map("Msg_ID")
  sessionId  Int         @map("Session_ID")
  /// "customer" | "bot" | "staff"
  sender     String      @map("Sender") @db.VarChar(20)
  /// Tên hiển thị (tên khách hoặc tên nhân viên)
  senderName String      @map("Sender_Name") @db.VarChar(100)
  body       String      @map("Body") @db.VarChar(2000)
  createdAt  DateTime    @default(now()) @map("Created_At")
  session    ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("Chat_Messages")
}

/// Gói Combo — tập hợp nhiều sản phẩm bán với giá ưu đãi
model Combo {
  id            Int           @id @default(autoincrement()) @map("Combo_ID")
  name          String        @map("Combo_Name") @db.VarChar(255)
  description   String?       @map("Description") @db.VarChar(1000)
  imageUrl      String?       @map("Image_URL") @db.VarChar(1024)
  /// Tổng giá gốc các món (tính tự động từ ComboItem)
  originalPrice Int           @default(0) @map("Original_Price")
  /// Giá bán combo (nhỏ hơn originalPrice)
  comboPrice    Int           @map("Combo_Price")
  /// Combo nổi bật hiển thị trên trang chủ
  isHot         Boolean       @default(false) @map("Is_Hot")
  isActive      Boolean       @default(true) @map("Is_Active")
  createdAt     DateTime      @default(now()) @map("Created_At")
  updatedAt     DateTime      @updatedAt @map("Updated_At")
  items         ComboItem[]
  orderLines    OrderDetail[]

  @@map("Combos")
}

/// Bảng trung gian: mỗi dòng = 1 sản phẩm trong 1 combo
model ComboItem {
  id        Int     @id @default(autoincrement()) @map("CI_ID")
  comboId   Int     @map("Combo_ID")
  productId Int     @map("Product_ID")
  /// Số lượng sản phẩm này trong 1 lần mua combo (vd: 2 ly cà phê)
  quantity  Int     @default(1) @map("Quantity")
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@map("Combo_Items")
}

/// Cấu hình tính lương chung
model PayrollConfig {
  id             Int @id @default(1) @map("Config_ID")
  defaultDaysOff Int @default(4) @map("Default_Days_Off")
  globalBonus    Int @default(0) @map("Global_Bonus")

  @@map("Payroll_Configs")
}

/// Phiếu lương từng tháng của nhân viên
model Payslip {
  id               Int      @id @default(autoincrement()) @map("Payslip_ID")
  staffId          Int      @map("Staff_ID")
  month            Int      @map("Month")
  year             Int      @map("Year")
  standardDays     Float    @map("Standard_Days")
  actualWorkedDays Float    @map("Actual_Worked_Days")
  baseSalary       Int      @map("Base_Salary")
  dailyRate        Int      @map("Daily_Rate")
  allowance        Int      @map("Allowance")
  globalBonus      Int      @default(0) @map("Global_Bonus")
  individualBonus  Int      @default(0) @map("Individual_Bonus")
  /// Số phút làm thêm được tính lương (đã duyệt phiếu + khớp giờ check-out)
  overtimeMinutes  Int      @default(0) @map("Overtime_Minutes")
  overtimePay      Int      @default(0) @map("Overtime_Pay")
  /// Shipper: tổng phí ship các đơn giao thành công trong tháng (khách đã trả cùng đơn, quán giữ hộ)
  shippingIncome   Int      @default(0) @map("Shipping_Income")
  deliveredOrders  Int      @default(0) @map("Delivered_Orders")
  netSalary        Int      @map("Net_Salary")
  status           String   @default("PENDING") @map("Status") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("Created_At")

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, month, year])
  @@map("Payslips")
}

/// ─── CÁC BẢNG MỚI: TỰ ĐỘNG KHO & MUA HÀNG ──────────────────────────────

model InventoryTransaction {
  id              Int      @id @default(autoincrement()) @map("Tx_ID")
  itemId          Int      @map("Item_ID")
  /// Theo đơn vị kho, có thể lẻ (VD bán 1 ly trừ 0.02 bịch cà phê)
  qtyChange       Float    @map("Qty_Change")
  newStockQty     Float    @map("New_Stock_Qty")
  transactionType String   @map("Tx_Type") @db.VarChar(50)
  referenceId     String?  @map("Ref_ID") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("Created_At")

  item InventoryItem @relation(fields: [itemId], references: [id])

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Inventory_Transactions")
}

model PurchaseRequisition {
  id        Int      @id @default(autoincrement()) @map("PR_ID")
  code      String   @unique @map("PR_Code") @db.VarChar(50)
  staffId   Int      @map("Staff_ID")
  status    String   @default("PENDING") @map("Status") @db.VarChar(20)
  note      String?  @map("Note") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("Created_At")
  updatedAt DateTime @updatedAt @map("Updated_At")

  staff Staff                     @relation("PRByStaff", fields: [staffId], references: [id])
  items PurchaseRequisitionItem[]
  rfqs  RequestForQuotation[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Purchase_Requisitions")
}

model PurchaseRequisitionItem {
  id            Int     @id @default(autoincrement()) @map("PRI_ID")
  requisitionId Int     @map("PR_ID")
  itemId        Int     @map("Item_ID")
  qty           Int     @map("Qty")
  note          String? @map("Note") @db.VarChar(500)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        InventoryItem       @relation(fields: [itemId], references: [id])

  @@unique([requisitionId, itemId])
  @@map("Purchase_Requisition_Items")
}

model SupplierQuote {
  id         Int      @id @default(autoincrement()) @map("Quote_ID")
  rfqId      Int      @map("RFQ_ID")
  supplierId Int      @map("Supplier_ID")
  status     String   @default("PENDING") @map("Status") @db.VarChar(20)
  note       String?  @map("Note") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("Created_At")
  updatedAt  DateTime @updatedAt @map("Updated_At")

  rfq           RequestForQuotation @relation(fields: [rfqId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         SupplierQuoteItem[]
  purchaseOrder PurchaseOrder?

  @@unique([rfqId, supplierId])
  @@map("Supplier_Quotes")
}

model RequestForQuotation {
  id            Int       @id @default(autoincrement()) @map("RFQ_ID")
  code          String    @unique @map("RFQ_Code") @db.VarChar(50)
  requisitionId Int       @map("PR_ID")
  status        String    @default("OPEN") @map("Status") @db.VarChar(20)
  deadline      DateTime? @map("Deadline")
  createdAt     DateTime  @default(now()) @map("Created_At")
  updatedAt     DateTime  @updatedAt @map("Updated_At")

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  quotes      SupplierQuote[]

  @@map("Request_For_Quotations")
}

model GoodsReceipt {
  id           Int      @id @default(autoincrement()) @map("GRN_ID")
  code         String   @unique @map("GRN_Code") @db.VarChar(50)
  poId         Int      @map("PO_ID")
  receivedById Int      @map("Received_By")
  status       String   @default("PENDING") @map("Status") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("Created_At")

  po         PurchaseOrder      @relation(fields: [poId], references: [id])
  receivedBy Staff              @relation(fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]
  bill       SupplierBill?

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Goods_Receipts")
}

model GoodsReceiptItem {
  id          Int       @id @default(autoincrement()) @map("GRI_ID")
  grnId       Int       @map("GRN_ID")
  itemId      Int       @map("Item_ID")
  receivedQty Int       @map("Received_Qty")
  expiryDate  DateTime? @map("Expiry_Date") @db.Date

  grn   GoodsReceipt    @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item  InventoryItem   @relation(fields: [itemId], references: [id])
  batch InventoryBatch?

  @@map("Goods_Receipt_Items")
}

model InventoryBatch {
  id           Int       @id @default(autoincrement()) @map("Batch_ID")
  itemId       Int       @map("Item_ID")
  grnItemId    Int       @unique @map("GRI_ID")
  originalQty  Int       @map("Original_Qty")
  remainingQty Int       @map("Remaining_Qty")
  expiryDate   DateTime? @map("Expiry_Date") @db.Date
  createdAt    DateTime  @default(now()) @map("Created_At")

  item    InventoryItem    @relation(fields: [itemId], references: [id])
  grnItem GoodsReceiptItem @relation(fields: [grnItemId], references: [id])

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Inventory_Batches")
}

model SupplierQuoteItem {
  id           Int       @id @default(autoincrement()) @map("SQI_ID")
  quoteId      Int       @map("Quote_ID")
  itemId       Int       @map("Item_ID")
  unitPrice    Int       @map("Unit_Price")
  deliveryDate DateTime? @map("Delivery_Date") @db.Date
  note         String?   @map("Note") @db.VarChar(500)

  quote SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([quoteId, itemId])
  @@map("Supplier_Quote_Items")
}

model PurchaseOrder {
  id          Int      @id @default(autoincrement()) @map("PO_ID")
  code        String   @unique @map("PO_Code") @db.VarChar(50)
  quoteId     Int      @unique @map("Quote_ID")
  supplierId  Int      @map("Supplier_ID")
  status      String   @default("PENDING") @map("Status") @db.VarChar(20)
  totalAmount Int      @map("Total_Amount")
  createdAt   DateTime @default(now()) @map("Created_At")
  updatedAt   DateTime @updatedAt @map("Updated_At")

  quote    SupplierQuote  @relation(fields: [quoteId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  receipts GoodsReceipt[]

  /// Chi nhánh
  storeId Int   @map("Store_ID")
  store   Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("Purchase_Orders")
}

/// ─── CHUỖI CỬA HÀNG ──────────────────────────────────────────────

/// Chi nhánh trong chuỗi
model Store {
  id            Int      @id @default(autoincrement()) @map("Store_ID")
  /// Mã ngắn, VD "Q1"
  code          String   @unique @map("Store_Code") @db.VarChar(20)
  name          String   @map("Store_Name") @db.VarChar(255)
  address       String?  @map("Address") @db.VarChar(255)
  phone         String?  @map("Phone") @db.VarChar(20)
  /// Toạ độ quán (GPS chấm công, tính phí ship)
  lat           Float    @default(10.7769) @map("Lat")
  lng           Float    @default(106.7009) @map("Lng")
  /// Bán kính cho phép chấm công (mét)
  allowedRadius Int      @default(50) @map("Allowed_Radius")
  /// Giờ mở/đóng cửa, dạng "HH:mm"
  openTime      String?  @map("Open_Time") @db.VarChar(5)
  closeTime     String?  @map("Close_Time") @db.VarChar(5)
  isActive      Boolean  @default(true) @map("Is_Active")
  createdAt     DateTime @default(now()) @map("Created_At")

  staff              Staff[]
  zones              Zone[]
  tables             CafeTable[]
  orders             Order[]
  shifts             Shift[]
  workSchedules      WorkSchedule[]
  inventoryRequests  InventoryRequest[]
  stockReceipts      StockReceipt[]
  shiftInventoryLogs ShiftInventoryLog[]
  auditLogs          AuditLog[]
  chatSessions       ChatSession[]
  inventoryTxs       InventoryTransaction[]
  purchaseReqs       PurchaseRequisition[]
  goodsReceipts      GoodsReceipt[]
  inventoryBatches   InventoryBatch[]
  purchaseOrders     PurchaseOrder[]
  products           StoreProduct[]
  inventory          StoreInventory[]
  vouchers           VoucherStore[]
  transfersOut       StockTransfer[]        @relation("TransferFrom")
  transfersIn        StockTransfer[]        @relation("TransferTo")
  cashEntries        CashEntry[]
  safeSessions       SafeSession[]
  supplierBills      SupplierBill[]

  @@map("Stores")
  wasteLogs WasteLog[]
  stockRequests         StockRequest[]  @relation("StockRequestStore")
  stockRequestsAccepted StockRequest[]  @relation("StockRequestFromStore")
  menuProposals         MenuProposal[]
}

/// Món bán tại chi nhánh. Không có dòng = đang bán bình thường.
model StoreProduct {
  storeId     Int     @map("Store_ID")
  productId   Int     @map("Product_ID")
  /// false = chi nhánh không bán món này
  isAvailable Boolean @default(true) @map("Is_Available")
  outOfStock  Boolean @default(false) @map("Out_Of_Stock")
  store       Store   @relation(fields: [storeId], references: [id])
  product     Product @relation(fields: [productId], references: [id])

  @@id([storeId, productId])
  @@map("Store_Products")
}

/// Tồn kho nguyên liệu theo chi nhánh
model StoreInventory {
  storeId  Int           @map("Store_ID")
  itemId   Int           @map("Item_ID")
  /// Theo đơn vị kho, có thể lẻ vì bán hàng trừ theo định mức (g, ml → bịch, hộp)
  stockQty Float         @default(0) @map("Stock_Qty")
  minLevel Int           @default(0) @map("Min_Level")
  store    Store         @relation(fields: [storeId], references: [id])
  item     InventoryItem @relation(fields: [itemId], references: [id])

  @@id([storeId, itemId])
  @@map("Store_Inventory")
}

/// Phiếu chuyển kho giữa hai chi nhánh
model StockTransfer {
  id           Int       @id @default(autoincrement()) @map("Transfer_ID")
  code         String    @unique @map("Transfer_Code") @db.VarChar(50)
  fromStoreId  Int       @map("From_Store_ID")
  toStoreId    Int       @map("To_Store_ID")
  /// PENDING → SHIPPED → RECEIVED | CANCELLED
  status       String    @default("PENDING") @map("Status") @db.VarChar(20)
  note         String?   @map("Note") @db.VarChar(500)
  createdById  Int       @map("Created_By")
  receivedById Int?      @map("Received_By")
  createdAt    DateTime  @default(now()) @map("Created_At")
  shippedAt    DateTime? @map("Shipped_At")
  receivedAt   DateTime? @map("Received_At")

  fromStore  Store               @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore    Store               @relation("TransferTo", fields: [toStoreId], references: [id])
  createdBy  Staff               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  receivedBy Staff?              @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  items      StockTransferItem[]

  /// Tạo ra từ yêu cầu hàng gấp của chi nhánh nhận
  stockRequest StockRequest?
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("Stock_Transfers")
}

model StockTransferItem {
  id          Int           @id @default(autoincrement()) @map("STI_ID")
  transferId  Int           @map("Transfer_ID")
  itemId      Int           @map("Item_ID")
  qty         Int           @map("Qty")
  /// Số thực nhận (có thể khác qty khi hao hụt)
  receivedQty Int?          @map("Received_Qty")
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([transferId, itemId])
  @@map("Stock_Transfer_Items")
}

/// Voucher chỉ áp dụng tại một số chi nhánh. Voucher không có dòng nào = toàn chuỗi.
model VoucherStore {
  voucherId Int     @map("Voucher_ID")
  storeId   Int     @map("Store_ID")
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id])

  @@id([voucherId, storeId])
  @@map("Voucher_Stores")
}

/// ─── Cấu hình ca & chấm công (Chủ chuỗi đặt, áp dụng toàn chuỗi) ───
/// Mẫu ca làm việc, VD Ca sáng 07:00–15:00
model ShiftTemplate {
  id        Int            @id @default(autoincrement()) @map("ST_ID")
  /// Mã ca lưu vào Work_Schedules.Shift_Code
  code      String         @unique @map("Code") @db.VarChar(10)
  name      String         @map("Name") @db.VarChar(50)
  /// Phút từ 00:00 (VD 7*60 = 420)
  startMin  Int            @map("Start_Min")
  endMin    Int            @map("End_Min")
  color     String         @default("#6f4e37") @map("Color") @db.VarChar(9)
  sortOrder Int            @default(0) @map("Sort_Order")
  isActive  Boolean        @default(true) @map("Is_Active")
  staffing  StaffingRule[]

  @@map("Shift_Templates")
}

/// Định biên: mỗi ca cần bao nhiêu người cho từng vị trí
model StaffingRule {
  id              Int           @id @default(autoincrement()) @map("SR_ID")
  shiftTemplateId Int           @map("Shift_Template_ID")
  role            String        @map("Role") @db.VarChar(20)
  /// Thứ 2 – Thứ 6
  weekdayCount    Int           @default(0) @map("Weekday_Count")
  /// Thứ 7 – Chủ nhật
  weekendCount    Int           @default(0) @map("Weekend_Count")
  template        ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([shiftTemplateId, role])
  @@map("Staffing_Rules")
}

/// Quy tắc xếp lịch & chấm công (1 dòng)
model HrConfig {
  id                 Int @id @default(1) @map("Config_ID")
  /// Vào trễ quá N phút mới tính là đi muộn
  lateGraceMin       Int @default(5) @map("Late_Grace_Min")
  /// Ra sớm quá N phút mới tính là về sớm
  earlyLeaveGraceMin Int @default(5) @map("Early_Leave_Grace_Min")
  /// Số lần đi muộn trong tháng thì bị cảnh báo
  lateWarnThreshold  Int @default(3) @map("Late_Warn_Threshold")
  /// Được check-in sớm tối đa N phút
  earlyCheckInMin    Int @default(30) @map("Early_Check_In_Min")
  /// Nghỉ tối thiểu giữa 2 ca liên tiếp (giờ) — dùng khi tự xếp lịch
  minRestHours       Int @default(8) @map("Min_Rest_Hours")
  /// Số ca tối đa / tuần / người — dùng khi tự xếp lịch
  maxShiftsPerWeek   Int @default(6) @map("Max_Shifts_Per_Week")
  /// Phụ cấp làm thêm giờ: 1 giờ làm thêm = lương giờ × (100% + N%)
  overtimeRatePercent Int @default(15) @map("Overtime_Rate_Percent")
  /// Mỗi phiếu làm thêm tối đa N phút
  maxOvertimeMinutes  Int @default(240) @map("Max_Overtime_Minutes")

  @@map("Hr_Configs")
}

/// Đơn gắn với 1 ca: làm thêm giờ / xin về sớm / đi muộn / khác
enum WorkRequestType {
  OVERTIME
  EARLY_LEAVE
  LATE_ARRIVAL
  OTHER
}

model WorkRequest {
  id          Int             @id @default(autoincrement()) @map("WR_ID")
  userId      Int             @map("User_ID")
  scheduleId  Int?            @map("Schedule_ID")
  type        WorkRequestType @map("Type")
  /// Số phút làm thêm / về sớm / đi muộn (làm thêm: quản lý có thể duyệt ít hơn số xin)
  minutes     Int?            @map("Minutes")
  reason      String          @map("Reason") @db.VarChar(500)
  status      RequestStatus   @default(PENDING) @map("Status")
  managerId   Int?            @map("Manager_ID")
  managerNote String?         @map("Manager_Note") @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("Created_At")
  updatedAt   DateTime        @updatedAt @map("Updated_At")

  user     Staff         @relation("WorkRequests", fields: [userId], references: [id])
  manager  Staff?        @relation("WorkRequestApprovals", fields: [managerId], references: [id])
  schedule WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("Work_Requests")
}

/// Sổ hao hụt ở quầy pha chế: đổ bể, hư hỏng, làm lại món… (đã trừ kho)
model WasteLog {
  id        Int            @id @default(autoincrement()) @map("Waste_ID")
  storeId   Int            @map("Store_ID")
  staffId   Int            @map("Staff_ID")
  /// Hỏng cả món → trừ nguyên liệu theo định mức
  productId Int?           @map("Product_ID")
  size      String?        @map("Size") @db.VarChar(5)
  /// Hao hụt 1 nguyên liệu
  itemId    Int?           @map("Item_ID")
  /// Số ly (món) hoặc số đơn vị kho, có thể lẻ (nguyên liệu)
  qty       Float          @map("Qty")
  /// SPILL | BROKEN | EXPIRED | REMAKE | OTHER
  reason    String         @map("Reason") @db.VarChar(20)
  note      String?        @map("Note") @db.VarChar(255)
  /// Giá trị ước tính (VND) theo giá vốn
  costValue Int            @default(0) @map("Cost_Value")
  createdAt DateTime       @default(now()) @map("Created_At")
  store     Store          @relation(fields: [storeId], references: [id])
  staff     Staff          @relation(fields: [staffId], references: [id])
  product   Product?       @relation(fields: [productId], references: [id])
  item      InventoryItem? @relation(fields: [itemId], references: [id])

  @@index([storeId, createdAt])
  @@map("Waste_Logs")
}

/// Kho chi nhánh cần hàng gấp (chưa kịp đặt NCC) → chi nhánh khác còn hàng bấm "Chuyển giúp"
model StockRequest {
  id              Int            @id @default(autoincrement()) @map("SRQ_ID")
  /// Chi nhánh cần hàng
  storeId         Int            @map("Store_ID")
  itemId          Int            @map("Item_ID")
  /// Số lượng cần (đơn vị kho)
  qty             Float          @map("Qty")
  note            String?        @map("Note") @db.VarChar(255)
  /// OPEN → ACCEPTED (đã có chi nhánh chuyển) | CANCELLED
  status          String         @default("OPEN") @map("Status") @db.VarChar(20)
  createdById     Int            @map("Created_By")
  acceptedStoreId Int?           @map("Accepted_Store_ID")
  acceptedById    Int?           @map("Accepted_By")
  transferId      Int?           @unique @map("Transfer_ID")
  createdAt       DateTime       @default(now()) @map("Created_At")
  acceptedAt      DateTime?      @map("Accepted_At")
  store           Store          @relation("StockRequestStore", fields: [storeId], references: [id])
  acceptedStore   Store?         @relation("StockRequestFromStore", fields: [acceptedStoreId], references: [id])
  item            InventoryItem  @relation(fields: [itemId], references: [id])
  createdBy       Staff          @relation("StockRequestBy", fields: [createdById], references: [id])
  acceptedBy      Staff?         @relation("StockRequestAcceptedBy", fields: [acceptedById], references: [id])
  transfer        StockTransfer? @relation(fields: [transferId], references: [id])

  @@index([status])
  @@map("Stock_Requests")
}

/// Pha chế đề xuất món mới → Chủ chuỗi duyệt → tạo món từ đề xuất
model MenuProposal {
  id             Int       @id @default(autoincrement()) @map("MP_ID")
  storeId        Int       @map("Store_ID")
  staffId        Int       @map("Staff_ID")
  name           String    @map("Name") @db.VarChar(255)
  /// Mô tả hương vị / ý tưởng
  description    String?   @map("Description") @db.Text
  /// Nguyên liệu & cách làm
  recipe         String?   @map("Recipe") @db.Text
  suggestedPrice Int?      @map("Suggested_Price")
  categoryId     Int?      @map("Category_ID")
  imageUrl       String?   @map("Image_URL") @db.VarChar(1024)
  /// PENDING → APPROVED → CREATED (đã tạo món) | REJECTED
  status         String    @default("PENDING") @map("Status") @db.VarChar(20)
  ownerNote      String?   @map("Owner_Note") @db.VarChar(500)
  reviewedById   Int?      @map("Reviewed_By")
  reviewedAt     DateTime? @map("Reviewed_At")
  productId      Int?      @map("Product_ID")
  createdAt      DateTime  @default(now()) @map("Created_At")
  updatedAt      DateTime  @updatedAt @map("Updated_At")
  store          Store     @relation(fields: [storeId], references: [id])
  staff          Staff     @relation("MenuProposalBy", fields: [staffId], references: [id])
  reviewer       Staff?    @relation("MenuProposalReviewer", fields: [reviewedById], references: [id])
  category       Category? @relation(fields: [categoryId], references: [id])
  product        Product?  @relation(fields: [productId], references: [id])

  @@index([status])
  @@map("Menu_Proposals")
}

/// ─── THU CHI, KÉT & CÔNG NỢ ────────────────────────────────────────

/**
 * Sổ quỹ: mọi biến động tiền của chi nhánh giữa 3 quỹ
 *   SAFE   — két sắt của chi nhánh
 *   DRAWER — ngăn kéo thu ngân của 1 ca (shiftId)
 *   BANK   — tài khoản ngân hàng của chi nhánh
 * kind: IN (thu từ ngoài vào quỹ) · OUT (chi từ quỹ ra ngoài) · TRANSFER (chuyển giữa 2 quỹ) · ADJUST (điều chỉnh khi kiểm đếm lệch)
 * Tiền bán hàng không ghi ở đây mà lấy từ Payments.
 */
model CashEntry {
  id             Int       @id @default(autoincrement()) @map("Entry_ID")
  /// PT-… phiếu thu, PC-… phiếu chi, CQ-… chuyển quỹ, DC-… điều chỉnh
  code           String    @unique @map("Code") @db.VarChar(30)
  storeId        Int       @map("Store_ID")
  kind           String    @map("Kind") @db.VarChar(10)
  fromFund       String?   @map("From_Fund") @db.VarChar(10)
  toFund         String?   @map("To_Fund") @db.VarChar(10)
  /// Ngăn kéo của ca nào (khi một đầu là DRAWER)
  shiftId        Int?      @map("Shift_ID")
  /// Lần mở két nào (khi một đầu là SAFE)
  safeSessionId  Int?      @map("Safe_Session_ID")
  category       String    @map("Category") @db.VarChar(30)
  amount         Int       @map("Amount")
  description    String?   @map("Description") @db.VarChar(500)
  /// Ảnh hoá đơn / chứng từ
  attachmentUrl  String?   @map("Attachment_Url") @db.VarChar(500)
  /// PENDING (chờ duyệt, chưa tính vào quỹ) · APPROVED · REJECTED · CANCELLED
  status         String    @default("APPROVED") @map("Status") @db.VarChar(15)
  rejectReason   String?   @map("Reject_Reason") @db.VarChar(255)
  /// Phiếu chi trả nhà cung cấp
  supplierBillId Int?      @map("Supplier_Bill_ID")
  createdById    Int       @map("Created_By")
  approvedById   Int?      @map("Approved_By")
  approvedAt     DateTime? @map("Approved_At")
  createdAt      DateTime  @default(now()) @map("Created_At")

  store        Store         @relation(fields: [storeId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  safeSession  SafeSession?  @relation(fields: [safeSessionId], references: [id])
  supplierBill SupplierBill? @relation(fields: [supplierBillId], references: [id])
  createdBy    Staff         @relation("CashEntryCreatedBy", fields: [createdById], references: [id])
  approvedBy   Staff?        @relation("CashEntryApprovedBy", fields: [approvedById], references: [id])

  @@index([storeId, createdAt])
  @@index([shiftId])
  @@map("Cash_Entries")
}

/// Một lần mở két: mở (ghi lý do) → lấy / bỏ tiền → đóng (đếm lại tiền trong két, lệch thì ghi lý do)
model SafeSession {
  id              Int       @id @default(autoincrement()) @map("Session_ID")
  storeId         Int       @map("Store_ID")
  reason          String    @map("Reason") @db.VarChar(255)
  openedById      Int       @map("Opened_By")
  openedAt        DateTime  @default(now()) @map("Opened_At")
  /// Số dư két theo sổ lúc mở
  openingBalance  Int       @map("Opening_Balance")
  closedById      Int?      @map("Closed_By")
  closedAt        DateTime? @map("Closed_At")
  /// Số dư theo sổ lúc đóng (đã gồm mọi lần lấy/bỏ tiền trong phiên)
  expectedBalance Int?      @map("Expected_Balance")
  countedBalance  Int?      @map("Counted_Balance")
  difference      Int?      @map("Difference")
  denominations   String?   @map("Denominations") @db.Text
  note            String?   @map("Note") @db.VarChar(255)

  store    Store       @relation(fields: [storeId], references: [id])
  openedBy Staff       @relation("SafeOpenedBy", fields: [openedById], references: [id])
  closedBy Staff?      @relation("SafeClosedBy", fields: [closedById], references: [id])
  entries  CashEntry[]

  @@index([storeId, openedAt])
  @@map("Safe_Sessions")
}

/// Công nợ phải trả nhà cung cấp — phát sinh khi nhận hàng (phiếu nhập) hoặc nhập tay hoá đơn mua ngoài
model SupplierBill {
  id          Int      @id @default(autoincrement()) @map("Bill_ID")
  code        String   @unique @map("Code") @db.VarChar(30)
  storeId     Int      @map("Store_ID")
  supplierId  Int      @map("Supplier_ID")
  /// GRN = từ phiếu nhập hàng · MANUAL = hoá đơn nhập tay
  source      String   @default("MANUAL") @map("Source") @db.VarChar(10)
  grnId       Int?     @unique @map("GRN_ID")
  amount      Int      @map("Amount")
  paidAmount  Int      @default(0) @map("Paid_Amount")
  billDate    DateTime @default(now()) @map("Bill_Date")
  dueDate     DateTime @map("Due_Date")
  /// UNPAID · PARTIAL · PAID · CANCELLED
  status      String   @default("UNPAID") @map("Status") @db.VarChar(15)
  note        String?  @map("Note") @db.VarChar(500)
  createdById Int?     @map("Created_By")
  createdAt   DateTime @default(now()) @map("Created_At")

  store     Store         @relation(fields: [storeId], references: [id])
  supplier  Supplier      @relation(fields: [supplierId], references: [id])
  grn       GoodsReceipt? @relation(fields: [grnId], references: [id])
  createdBy Staff?        @relation("SupplierBillCreatedBy", fields: [createdById], references: [id])
  payments  CashEntry[]

  @@index([storeId, status])
  @@index([supplierId])
  @@map("Supplier_Bills")
}
