# Chỉ cần khi chạy `npm run build` / deploy — trỏ tới API công khai.
# Khi `npm run dev`, frontend gọi /api qua Vite proxy (bỏ qua biến này).
# VITE_API_URL=https://your-api.example.com

# Đăng nhập khách bằng Google / Facebook (ID công khai, KHÔNG để secret ở đây).
# Bỏ trống thì frontend dùng ID backend trả về ở /api/auth/providers.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
