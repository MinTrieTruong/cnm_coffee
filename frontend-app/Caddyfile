# DOMAIN lấy từ biến môi trường (deploy/.env). Caddy tự xin chứng chỉ HTTPS Let's Encrypt.
{$DOMAIN:localhost} {
	encode zstd gzip

	# API, ảnh upload và Socket.io chuyển sang backend (cùng tên miền → không lỗi CORS / ảnh /uploads)
	@backend path /api/* /uploads/* /socket.io/*
	handle @backend {
		reverse_proxy backend:4000
	}

	# Giao diện React (SPA): đường dẫn không tồn tại → index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
